#MOVER
#==================================================================

def mover():
    origem = input("\nNome do arquivo/pasta: ")
    
    if not os.path.exists(origem):
        print("Nada Encontrado. (ᴗ˳ᴗ)ᶻ𝗓𐰁")
        return

    destino = input("Destino (pasta): ")

    if not os.path.exists(destino):
        print("Destino inválido. (¬_¬')")
        return

    nvcaminho = os.path.join(destino, os.path.basename(origem))

    if os.path.exists(nvcaminho):
        print("Já existe algo com esse nome no destino.(¬_¬')")
        return

    shutil.move(origem, nvcaminho)

    print(f"Movido para {nvcaminho} (╭ರ_•́)")

