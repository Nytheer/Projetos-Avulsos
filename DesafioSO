def listar_arqs():
    print("\nARQUIVOS:")
    for item in os.listdir("."):
        if os.path.isfile(item):
            print(f"[ARQ]: {item}")
        elif os.path.isdir(item):
            print(f"[DIR]: {item}")

#==================================================================
#CRIAÇÃO DE ARQUIVOS
#==================================================================

def criar_arq():
    nome = input("\nNome: ")
    texto = input("Conteúdo do Arquivo: ")
    if os.path.exists(nome):
        print("Arquivo já existe.")
    else:
        with open(nome, "w") as f:
            f.write(texto)
        print("Criado com triunfo!(╭ರ_•́)")

