#==================================================================
# EDIÇÃO DE PASTAS - SUBMENU
#==================================================================

def edit_pastas():
    while True:
        print("\n=======================================================")
        print("SUBMENU // PASTAS")
        print("=======================================================")
        print("[1] Criar pasta")
        print("[2] Criar arquivo em pasta")
        print("[3] Navegar entre pastas")
        print("[4] Voltar")

        op = input("Escolha uma opção: ")

        #SAÍDA
        if op == "4":
            return

        #CRIAR PASTA
        elif op == "1":
            nome = input("Nome da pasta: ")
            try:
                os.mkdir(nome)
                print("Pasta criada!")
            except Exception as e:
                print(f"Erro: {e}")

        #CRIAR ARQUIVO EM PASTA
        elif op == "2":
            pasta = input("Nome da pasta: ")

            if not os.path.exists(pasta):
                print("Pasta não encontrada.")
                continue

            nome = input("Nome do arquivo: ")
            texto = input("Conteúdo: ")

            caminho = os.path.join(pasta, nome)

            if os.path.exists(caminho):
                print("Já existe um arquivo com esse nome.")
                continue

            with open(caminho, "w") as f:
                f.write(texto)

            print("Arquivo criado com sucesso!")

        #NAVEGAÇÃO
        elif op == "3":
            navegacao()

        else:
            print("Operação inválida.")

