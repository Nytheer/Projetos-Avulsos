#==================================================================
#COPIAR
#==================================================================

def copiar():
    origem = input("\nNome do arquivo OU pasta: ")

    if not os.path.exists(origem):
        print("Nada encontrado.(¬_¬')")
        return

    destino = input("Destino: ")

    if not os.path.exists(destino):
        print("Destino inválido. (ᴗ˳ᴗ)ᶻ𝗓𐰁")
        return

    nvcaminho = os.path.join(destino, os.path.basename(origem))
    origem_abs = os.path.abspath(origem)
    destino_abs = os.path.abspath(nvcaminho)

    if origem_abs == destino_abs:
        print("Origem e destino são o mesmo arquivo.(¬_¬')")
        return

    if os.path.exists(nvcaminho):
        escolha = input("Já existe. Sobrescrever? (s/n): ")

        if escolha.lower() != "s":
            print("Cancelado.(x__x)")
            return

    try:
        if os.path.isfile(origem):
            shutil.copy(origem, nvcaminho)
            print("Arquivo copiado!(ᵔ ᗜ ᵔ)")
        elif os.path.isdir(origem):
            shutil.copytree(origem, nvcaminho)
            print("Pasta copiada!(ᵔ ᗜ ᵔ)")
    except Exception as e:
        print(f"Erro: {e}")

#==================================================================
# DELETAÇÃO
#==================================================================

def deletar():
    nome = input("\nNome do Item para deletar: ")

    if not os.path.exists(nome):
        print("Nada Foi achado. (¬_¬')")
        return

    confirm = input("Tem certeza que deseja deletar? (s/n): ")

    if confirm.lower() != "s":
        print("Cancelado.(x__x)")
        return

    if os.path.isfile(nome):
        os.remove(nome)
        print("Arquivo deletado!(ᵕ•᷄_•᷅ )")

    elif os.path.isdir(nome):
        try:
            os.rmdir(nome)
            print("Pasta vazia deletada!(x__x)")
        except Exception as e:
            try:
                shutil.rmtree(nome)
                print("Pasta com conteúdo deletada!(x__x)")
            except Exception as e:
                print(f"Erro:{e}")

