# LISTAR E MONITORAR PROCESSOS E RECURSOS
#==================================================================

def listar_processos():
    print("\nPROCESSOS:")
    for p in psutil.process_iter(['pid', 'name']):
        try:
            print(f"PID: {p.info['pid']} | Nome: {p.info['name']}")
        except Exception:
            pass

def sistema():
    print("\nSISTEMA:")
    print("CPU:", psutil.cpu_percent(), "%")
    print("Memória:", psutil.virtual_memory().percent, "%")

#==================================================================
# SIMULAR ESCALONAMENTO DE PROCESSOS
#==================================================================

def simular():
    processos = [
        {"nome": "P1", "tempo": 5},
        {"nome": "P2", "tempo": 3},
        {"nome": "P3", "tempo": 4}
    ]

    quantum = 2
    fila = [p.copy() for p in processos]

    print("================================================")

    while len(fila) > 0:
        p = fila.pop(0)
    
        exec_time = min(quantum, p["tempo"])
        print(f"{p['nome']} executando por {exec_time}s (restante: {p['tempo']}s)")

        if p["tempo"] > quantum:
            p["tempo"] -= exec_time
            time.sleep(1)
            fila.append(p) 
        else:
            time.sleep(1)
            print(f"{p['nome']} finalizado")

#==================================================================
# MONITORAR DISCO E MEMORIA
#==================================================================

def monitorardisk_ram():
    print("\nMONITORAMENTO/DESEMPENHO:")

    cpu = psutil.cpu_percent(interval=1)
    mem = psutil.virtual_memory()
    disco = psutil.disk_usage(os.getcwd())

    print(f"CPU: {cpu}%")
    print(f"Memória: {mem.percent}% ({mem.used // (1024**2)} MB usados)")
    print(f"Disco: {disco.percent}% usado")

